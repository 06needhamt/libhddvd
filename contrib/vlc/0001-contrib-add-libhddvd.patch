From 98b68b61548ecc8c17a90580a3150cc9f59d8b0a Mon Sep 17 00:00:00 2001
From: Tom Needham <06needhamt@gmail.com>
Date: Wed, 11 Nov 2026 18:49:23 +0000
Subject: [PATCH 1/3] contrib: add libhddvd

libhddvd reads HD DVD discs. It is licensed under the LGPL, version 2.1
or later, as libbluray and libdvdnav are, so it is built in LGPL builds
too. It is built static, without its optional script engine, and needs
libxml2.
---
 contrib/src/hddvd/rules.mak | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 contrib/src/hddvd/rules.mak

diff --git a/contrib/src/hddvd/rules.mak b/contrib/src/hddvd/rules.mak
new file mode 100644
index 0000000..f1fbf90
--- /dev/null
+++ b/contrib/src/hddvd/rules.mak
@@ -0,0 +1,32 @@
+# libhddvd
+
+LIBHDDVD_VERSION := 0.6.0
+LIBHDDVD_URL := $(GITHUB)/06needhamt/libhddvd/archive/refs/tags/v$(LIBHDDVD_VERSION).tar.gz
+
+ifdef BUILD_DISCS
+PKGS += hddvd
+endif
+ifeq ($(call need_pkg,"libhddvd >= 0.6.0"),)
+PKGS_FOUND += hddvd
+endif
+
+DEPS_hddvd = libxml2 $(DEPS_libxml2)
+
+$(TARBALLS)/libhddvd-$(LIBHDDVD_VERSION).tar.gz:
+	$(call download_pkg,$(LIBHDDVD_URL),hddvd)
+
+.sum-hddvd: libhddvd-$(LIBHDDVD_VERSION).tar.gz
+
+hddvd: libhddvd-$(LIBHDDVD_VERSION).tar.gz .sum-hddvd
+	$(UNPACK)
+	$(MOVE)
+
+HDDVD_CONF := -DHDDVD_BUILD_SHARED=OFF -DHDDVD_BUILD_STATIC=ON \
+	-DHDDVD_SCRIPT_ENGINE=none -DBUILD_TESTING=OFF
+
+.hddvd: hddvd toolchain.cmake
+	$(CMAKECLEAN)
+	$(HOSTVARS_CMAKE) $(CMAKE) $(HDDVD_CONF)
+	+$(CMAKEBUILD)
+	$(CMAKEINSTALL)
+	touch $@
-- 
