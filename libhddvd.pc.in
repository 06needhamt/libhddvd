prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libhddvd
Description: HD DVD resource, inspection, display-list, and navigation library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lhddvd
Requires.private: libxml-2.0
Libs.private: @HDDVD_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
